# YXZ Tube production server
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

MONGO_URI=mongodb://mongo:27017/yxz
REDIS_URL=redis://redis:6379

# Replace in production — min 16 chars
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

PLAYBACK_CACHE_MAX_TTL_SEC=600
PLAYBACK_TIMEOUT_MS=20000

YTDLP_BIN=/usr/local/bin/yt-dlp
DENO_BIN=/usr/local/bin/deno
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe

DOWNLOAD_DIR=/data/downloads
PUBLIC_BASE_URL=http://localhost:8080

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Set to 1 to enqueue extract jobs instead of inline resolve
YXZ_USE_EXTRACT_WORKER=0

# Dev-only PO stub (never enable in production)
YXZ_PO_TOKEN_STUB=0

EXTRACT_CONCURRENCY=2
DOWNLOAD_CONCURRENCY=1
